{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/valence-ui",
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": [
      "src/lib"
    ]
  },
  "assets": [
    {
      "input": ".",
      "glob": "llms*.txt",
      "output": "."
    },
    {
      "input": "bin",
      "glob": "**/*",
      "output": "bin"
    },
    {
      "input": "ai",
      "glob": "**/*",
      "output": "ai"
    },
    {
      "input": "src/lib/styles",
      "glob": "**/*",
      "output": "styles"
    },
    {
      "input": "src/lib/themes",
      "glob": "**/*",
      "output": "themes"
    }
  ]
}